<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
    PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings>
        <setting name="logImpl" value="SLF4J"/>
    </settings>
    <typeAliases>
        <typeAlias type="dbp.backend.settlement.model.Settlement" alias="Settlement"/>
        <typeAlias type="dbp.backend.settlement.model.SettlementShare" alias="SettlementShare"/>
    </typeAliases>
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${DB_DRIVER}"/>
                <property name="url" value="${DB_URL}"/>
                <property name="username" value="${DB_USERNAME}"/>
                <property name="password" value="${DB_PASSWORD}"/>
            </dataSource>
        </environment>
    </environments>
    <mappers>
        <!-- mapper interface의 경로 지정 -->
        <mapper class="dbp.backend.settlement.dao.SettlementMapper"/>
    </mappers>
</configuration>
